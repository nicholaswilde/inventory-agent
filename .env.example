# Homebox Configuration
# The IP address or hostname where your Homebox instance is running
HOMEBOX_IP="127.0.0.1"

# Your Homebox API key
# You can generate this from the Homebox web interface under your profile settings
HOMEBOX_API_KEY="your_api_key_here"

# Coveralls Configuration (optional for local reporting)
# Set your Coveralls repo token to report coverage from local machine
COVERALLS_REPO_TOKEN=""
